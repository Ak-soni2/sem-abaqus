# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Scratch from the CAD viewer harnesses (_cadviewer_check/_shot/_drive.py).
# Screenshots and built pages, regenerated on every run.
_cadshot_*.png
_cadcheck_*
_caddrive.*

# The SAG reference deck: 135 MB, over GitHub's 100 MB hard limit. It is an
# INPUT (hand-built in CAE by the user), not generated output, so nothing can
# rebuild it -- keep the local copy. Its full analysis is in SAG_CONTEXT.md.
# The paper PDF and the PPTX are tracked: they are small and are the sources.
SHAPE ADAPTIVE GRINDING/*.inp
SHAPE ADAPTIVE GRINDING/_paper.txt
SHAPE ADAPTIVE GRINDING/_ppt.txt

# SAG decks and scratch. The MACRO deck is ~150 MB (2.3 M rigid grain facets
# on a 17 deg sector at the real pad density), over GitHub's limit and
# regenerable:
#     python -m semgrit.sagemit          # a demo pair
#     python verify_sag_deck.py --build  # a pair, then verify both
RUN_SAG/**/*.inp
_sagverify/
_sagemit_demo/
_sagm/
_sagmeas/
_sagcadm/
_sagfig_demo/
_sag_meas/
_sagnb_*/
RUN_SAG/_meas/
# SAG_V2 decks: 12-61 MB each, rebuilt by `python _make_sag_v2.py`.
SAG_V2/**/*.inp
SAG_V2/_meas/
